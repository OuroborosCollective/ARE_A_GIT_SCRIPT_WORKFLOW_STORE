{
  "name": "are-store",
  "version": "1.0.0",
  "private": true,
  "description": "ARE — Another Revision Engineering. Evidence-first store for reusable GitHub automation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "test:responsive": "node tests/responsive.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js"
  }
}
